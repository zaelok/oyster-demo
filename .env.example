# Copy to .env (never committed). Only --provider anthropic reads the key.
OYSTER_ANTHROPIC_API_KEY=
# Only --provider claude-code reads this: the output of `claude setup-token`. With it set the
# subscription route works from any shell; without it the CLI's stored login must exist.
OYSTER_CLAUDE_CODE_OAUTH_TOKEN=

# Everything below has a default in oyster/config.py. Rates are dollars per 1M tokens and
# are PLACEHOLDERS: verify against published pricing before a real run. results.md records
# whatever rates were in effect.
# OYSTER_CHEAP_MODEL_ID=claude-haiku-4-5-20251001
# OYSTER_STRONG_MODEL_ID=claude-sonnet-4-5
# OYSTER_CHEAP_RATE_IN=1.00
# OYSTER_CHEAP_RATE_OUT=5.00
# OYSTER_STRONG_RATE_IN=3.00
# OYSTER_STRONG_RATE_OUT=15.00
# OYSTER_CACHE_DISCOUNT=0.90
# OYSTER_BUDGET_DOLLARS=1.00
# OYSTER_LATENCY_TOLERANCE_S=120.0
# OYSTER_CORPUS_DIR=oyster/corpus/cases
# OYSTER_RESULTS_PATH=results.md
# OYSTER_PRIORS_PATH=priors.json
